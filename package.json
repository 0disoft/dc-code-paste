    "@typescript/native-preview": "beta",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "prosemirror-model": "^1.25.12",
    "prosemirror-state": "^1.4.4",
    "prosemirror-transform": "^1.12.2",
