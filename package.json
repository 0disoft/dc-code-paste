{
  "name": "dc-code-paste",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "typecheck:go": "svelte-kit sync && tsgo --noEmit -p tsconfig.json --checkers 2",
    "test": "vitest",
    "test:e2e": "playwright test",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "@shikijs/langs": "^4.2.0",
    "@shikijs/themes": "^4.2.0",
    "@tiptap/core": "^3.25.0",
    "@tiptap/extension-code-block": "^3.25.0",
    "@tiptap/extension-color": "^3.25.0",
    "@tiptap/extension-font-family": "^3.25.0",
    "@tiptap/extension-link": "^3.25.0",
    "@tiptap/extension-text-style": "^3.25.0",
    "@tiptap/starter-kit": "^3.25.0",
    "lucide-svelte": "^0.468.0",
    "shiki": "^4.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.61.1",
    "@sveltejs/vite-plugin-svelte": "^5.1.0",
    "@types/node": "^24.10.1",
    "@typescript/native-preview": "beta",
    "oxfmt": "^0.52.0",
    "oxlint": "^1.65.0",
    "svelte": "^5.53.7",
    "svelte-check": "^4.4.8",
    "typescript": "^5.9.3",
    "vite": "^6.3.5",
    "vitest": "^4.1.8"
  },
  "packageManager": "bun@1.3.14"
}
