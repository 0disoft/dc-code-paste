    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@types/node": "^24.13.6",
    "@typescript/native-preview": "beta",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "prosemirror-model": "1.25.12",
    "prosemirror-state": "1.4.4",
    "prosemirror-transform": "1.12.1",
    "prosemirror-view": "1.42.5"
  },
  "packageManager": "bun@1.4.2"
